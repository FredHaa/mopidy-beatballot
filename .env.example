# Copy to .env and fill in.

# Music services to enable, comma-separated: spotify, tidal, soundcloud.
# With several, search covers all of them.
MUSIC_BACKENDS=tidal

# Playlists the random candidates come from, comma-separated. Picks are drawn
# at random from all their songs combined; the same song on two services
# counts once. Leave empty for a suggestions-only party: guests search and
# add every song on the ballot. Share links or URIs from any enabled service:
#   https://open.spotify.com/playlist/...      (use playlists you own: Spotify
#                                                blocks its editorial playlists)
#   https://tidal.com/browse/playlist/...
#   https://soundcloud.com/<user>/sets/<set>
BALLOT_PLAYLISTS=

# PIN guests type to join, and the host PIN for skip/pause/test mode/playlists.
BALLOT_PIN=1234
BALLOT_ADMIN_PIN=

# URL shown as a QR code on the big screen, e.g. http://192.168.1.50:6680/beatballot/
BALLOT_PUBLIC_URL=

# Losing songs with 2+ votes stay in the next round with their votes.
# The host can also toggle this live.
BALLOT_CARRY_OVER=true

# Behind a reverse proxy: its IPs/CIDRs (comma-separated), so PIN rate
# limiting sees each guest's real IP. E.g. Traefik's IP plus Cloudflare ranges.
BALLOT_TRUSTED_PROXIES=

# Play 30 s per song and lock votes after 15 s.
BALLOT_TEST_MODE=false

# --- Spotify: https://mopidy.com/ext/spotify/#authentication (needs Premium)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Tidal: no keys needed. On first start the host panel (and the log) shows
# a link.tidal.com login link; the session is then kept in ./data.
# LOW, HIGH, LOSSLESS or HI_RES_LOSSLESS
TIDAL_QUALITY=LOSSLESS

# --- SoundCloud: https://mopidy.com/ext/soundcloud/#authentication
SOUNDCLOUD_AUTH_TOKEN=

# GStreamer sink. Raspberry Pi examples (find cards with `aplay -l`):
#   alsasink device=hw:Headphones   (3.5 mm jack)
#   alsasink device=hw:vc4hdmi0     (HDMI 0)
#   alsasink device=hw:1,0          (USB DAC)
AUDIO_OUTPUT=alsasink
MIXER_VOLUME=80
