#!/bin/sh
set -e
if [ "$1" = purge ]; then
    rm -rf /var/lib/beatballot-player
    if getent passwd beatballot-player > /dev/null; then
        deluser --quiet --system beatballot-player > /dev/null 2>&1 || true
    fi
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload > /dev/null 2>&1 || true
fi
exit 0
